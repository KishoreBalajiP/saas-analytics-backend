# =============================================================================
# SaaS Analytics Platform - Backend environment variables
# Copy this file to `.env` and adjust for your local environment.
#   cp .env.example .env
# All variables are optional in development (sensible defaults are used).
# =============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development              # development | production | test
PORT=8080
APP_NAME=SaaS Analytics Platform
APP_VERSION=1.0.0                 # overrides the version read from package.json

# Base path for all API routes (prefix + API version).
API_PREFIX=/api/v1

# --- MongoDB ----------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/saas_analytics
MONGODB_CONNECT_ATTEMPTS=3
MONGODB_RETRY_DELAY_MS=2000
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=15000

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Primary frontend URL (fallback for CORS when CORS_ORIGINS is empty).
CLIENT_URL=http://localhost:3000

# --- Security ---------------------------------------------------------------
# MUST be a long random string in production. The dev default is insecure.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
# Short-lived access token lifetime (ISO-8601 duration, JWT).
JWT_ACCESS_TTL=15m
# Refresh token lifetime (ISO-8601 duration; opaque token in Session docs).
JWT_REFRESH_TTL=30d
# Name of the HttpOnly refresh-token cookie.
AUTH_COOKIE_NAME=saas_session
# SameSite policy for the auth cookie (Lax | Strict | None).
AUTH_COOKIE_SAMESITE=Lax
# Max failed login attempts before the account/session is locked out.
LOGIN_MAX_ATTEMPTS=5
# Lockout duration after exceeding LOGIN_MAX_ATTEMPTS (milliseconds).
LOGIN_LOCKOUT_MS=900000
# Password reset token TTL (milliseconds).
PASSWORD_RESET_TTL_MS=900000
# Length (in bytes) of the password reset token.
PASSWORD_RESET_TOKEN_LENGTH=32
# Issuer shown to users in TOTP authenticator apps (MFA).
MFA_ISSUER=saas-analytics
# Password KDF: argon2 (default, OWASP-recommended) or scrypt (Node built-in
# fallback). `npm test` forces scrypt so tests run on any machine; leave this
# unset (argon2) in production.
PASSWORD_KDF=scrypt
COOKIE_SECURE=true                # only send cookies over HTTPS
# Number of reverse-proxy hops to trust for correct client IPs.
# Set to 1 on Render/Railway/Docker-behind-nginx, 0 when exposing directly.
TRUST_PROXY=1

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000       # 15 minutes
RATE_LIMIT_MAX=300                # requests per window per IP
RATE_LIMIT_STRICT_MAX=20          # stricter limit for future auth endpoints

# Per-IP window/limit for the external API surface (X-Api-Key routes).
EXTERNAL_API_RATE_LIMIT_WINDOW_MS=60000
EXTERNAL_API_RATE_LIMIT_MAX=60
# Per-IP window/limit for the public embed read ({token} routes).
EMBED_RATE_LIMIT_WINDOW_MS=60000
EMBED_RATE_LIMIT_MAX=120

# --- External API keys (Sprint 9) --------------------------------------------
# Default lifetime (days) for a key when the caller sets no expiry.
API_KEY_TTL_DAYS=90
# Per-tenant cap on simultaneously-active keys.
API_KEY_MAX_PER_TENANT=100

# --- Embed tokens (Sprint 9) -------------------------------------------------
# Default token lifetime (seconds) when the caller sets no expiry.
EMBED_TOKEN_DEFAULT_TTL_SEC=86400        # 24h
# Hard ceiling for any embed token lifetime (seconds).
EMBED_TOKEN_MAX_TTL_SEC=604800           # 7d
# Cap on concurrently-active embed tokens per dashboard.
EMBED_MAX_PER_DASHBOARD=50
# Reflect any Origin on the public embed read (no credentials are attached).
EMBED_CORS_ALLOW_ALL=true

# --- Socket.IO --------------------------------------------------------------
# Comma-separated origins allowed to open WebSocket connections.
SOCKET_CORS_ORIGIN=http://localhost:3000
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_MAX_HTTP_BUFFER_SIZE=1000000
SOCKET_TRANSPORTS=polling,websocket

# --- Redis (cache + queue transport) ---------------------------------------
# Leave empty to use the in-memory transport (dev/test only).
REDIS_URL=

# --- Storage ---------------------------------------------------------------
# local (filesystem) or s3 (any S3-compatible service).
STORAGE_PROVIDER=local
STORAGE_BASE_DIR=uploads
# Required when STORAGE_PROVIDER=s3:
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=                      # leave empty for AWS, set for MinIO/R2/etc.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false         # true for MinIO and some S3-compatible services

# --- Encryption ------------------------------------------------------------
# Optional dedicated key for at-rest encryption. Falls back to JWT_SECRET
# when empty (Sprint 0). Rotate via the rotation utility; never edit live.
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_VERSION=1

# --- Mail (reserved for future transactional email) -------------------------
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
MAIL_SECURE=false                 # true when SMTP_PORT is 465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=SaaS Analytics Platform <noreply@localhost>

# --- Scheduler (node-cron infrastructure) ----------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# --- Support (Sprint 8) ------------------------------------------------------
# Max impersonation sessions an admin may start per UTC day (0 disables).
SUPPORT_IMPERSONATION_DAILY_CAP=20
# Lifetime of an impersonation bearer token before it expires.
SUPPORT_IMPERSONATION_TOKEN_TTL=15m

# --- Retention (Sprint 8 cleanup job) ----------------------------------------
# How many days records are kept before the cleanup job hard-deletes them.
RETENTION_AUDIT_LOG_DAYS=90
RETENTION_ACCESS_LOG_DAYS=30
RETENTION_LOGIN_ATTEMPT_DAYS=30
RETENTION_SESSION_DAYS=90
RETENTION_IDEMPOTENCY_DAYS=1
RETENTION_EXPORT_DAYS=1

# --- Connectors (Sprint 4) --------------------------------------------------
# Max CSV upload size in MB (multer caps the buffered file).
CONNECTOR_CSV_MAX_UPLOAD_MB=10
# Max XLSX upload size in MB (Sprint 9).
CONNECTOR_XLSX_MAX_UPLOAD_MB=10
# External-source MongoDB sync guards (Sprint 9).
MONGODB_CONNECTOR_MAX_DOCS_PER_SYNC=100000
MONGODB_CONNECTOR_CONNECT_TIMEOUT_MS=10000
MONGODB_CONNECTOR_SERVER_SELECTION_TIMEOUT_MS=5000
# Connector sync queue sizing.
CONNECTOR_QUEUE_CONCURRENCY=5
CONNECTOR_QUEUE_ATTEMPTS=5
CONNECTOR_QUEUE_BACKOFF_MS=2000
# Default webhook signature tolerance (seconds) when a connector does not
# set `toleranceSeconds` in its own config.
WEBHOOK_TOLERANCE_SECONDS=300
# Encryption context purpose scoping connector secrets per tenant.
CONNECTOR_ENCRYPTION_PURPOSE=connector

# --- Background jobs (all disabled in Phase 1) ------------------------------
JOB_SHEET_SYNC_CRON=0 */6 * * *
JOB_SHEET_SYNC_ENABLED=false
JOB_EMAIL_CRON=*/5 * * * *
JOB_EMAIL_ENABLED=false
JOB_CLEANUP_CRON=0 3 * * *
JOB_CLEANUP_ENABLED=false
JOB_ANOMALY_CRON=0 * * * *
JOB_ANOMALY_ENABLED=false

# --- Logging ----------------------------------------------------------------
# development: debug + pretty output. production: info + JSON output.
LOG_LEVEL=
# Comma-separated pino redact paths (sensitive values are masked in logs).
LOG_REDACT=req.headers.authorization,req.headers.cookie,password,authorization,jwt,token

# --- Request body limits ----------------------------------------------------
REQUEST_BODY_LIMIT=1mb

# --- Graceful shutdown ------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=10000
