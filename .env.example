# =============================================================================
# SaaS Analytics Platform - Backend environment variables
# Copy this file to `.env` and adjust for your local environment.
#   cp .env.example .env
# All variables are optional in development (sensible defaults are used).
# =============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development              # development | production | test
PORT=8080
APP_NAME=SaaS Analytics Platform
APP_VERSION=1.0.0                 # overrides the version read from package.json

# Base path for all API routes (prefix + API version).
API_PREFIX=/api/v1

# --- MongoDB ----------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/saas_analytics
MONGODB_CONNECT_ATTEMPTS=3
MONGODB_RETRY_DELAY_MS=2000
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=15000

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Primary frontend URL (fallback for CORS when CORS_ORIGINS is empty).
CLIENT_URL=http://localhost:3000

# --- Security ---------------------------------------------------------------
# MUST be a long random string in production. The dev default is insecure.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
# Short-lived access token lifetime (ISO-8601 duration, JWT).
JWT_ACCESS_TTL=15m
# Refresh token lifetime (ISO-8601 duration; opaque token in Session docs).
JWT_REFRESH_TTL=30d
# Name of the HttpOnly refresh-token cookie.
AUTH_COOKIE_NAME=saas_session
# SameSite policy for the auth cookie (Lax | Strict | None). Defaults to
# None in production and Lax elsewhere. Use None (with COOKIE_SECURE=true)
# when the frontend and API are on different sites, otherwise the refresh
# cookie is dropped cross-site and users are signed out on reload.
AUTH_COOKIE_SAMESITE=Lax
# Admin-portal refresh cookie. Each portal's cookie is scoped to its own
# auth path (/api/v1/auth or /api/v1/admin-auth), so the two never collide.
AUTH_ADMIN_COOKIE_NAME=saas_admin_session
# Optional parent domain for a first-party deployment (API and SPA on
# subdomains of one site, e.g. .example.com). With it set, use
# AUTH_COOKIE_SAMESITE=Lax so browsers that block third-party cookies
# (Safari, Brave) keep the session. Leave empty for a host-only cookie.
AUTH_COOKIE_DOMAIN=
# Absolute lifetime of one sign-in, enforced at refresh regardless of
# rotation (duration, e.g. 30d). After this the user must sign in again.
AUTH_SESSION_ABSOLUTE_TTL=30d
# How long (ms) one process reuses an account/tenant status lookup when
# authenticating requests. Changes made through the app apply at once.
AUTH_STATUS_CACHE_TTL_MS=5000
# Grace (ms) for a refresh token that was rotated moments ago (two tabs, a
# retry). Within it the duplicate gets an access token for the successor;
# after it, reuse is a replay and revokes every session. 0 disables it.
AUTH_REFRESH_REUSE_GRACE_MS=10000
# Max failed login attempts before the account/session is locked out.
LOGIN_MAX_ATTEMPTS=5
# Lockout duration after exceeding LOGIN_MAX_ATTEMPTS (milliseconds).
LOGIN_LOCKOUT_MS=900000
# Password reset link TTL (milliseconds). Default 1 hour.
PASSWORD_RESET_TTL_MS=3600000
# Length (in bytes) of the password reset token.
PASSWORD_RESET_TOKEN_LENGTH=32
# Email-verification link TTL (milliseconds). Default 24 hours.
EMAIL_VERIFICATION_TTL_MS=86400000
# Minimum gap between verification resend requests for the same account.
EMAIL_VERIFICATION_RESEND_COOLDOWN_MS=60000
# Issuer shown to users in TOTP authenticator apps (MFA).
MFA_ISSUER=saas-analytics
# adminauth: admin types that must use MFA (comma list, or `none`). An admin
# of these types signing in without MFA may only enrol MFA until done.
ADMIN_MFA_REQUIRED_TYPES=super,platform
# How long (ms) a step-up (password + current code) authorises sensitive
# admin actions on that session. Clamped to 30 s .. 1 h. Default 5 minutes.
ADMIN_STEP_UP_TTL_MS=300000
# Admin invitation link TTL (ms, default 72 hours) and the minimum gap
# between two resends for the same pending admin (ms).
ADMIN_INVITATION_TTL_MS=259200000
ADMIN_INVITATION_RESEND_COOLDOWN_MS=60000
# One-time MFA recovery codes issued per enrolment/regeneration (5..20).
MFA_RECOVERY_CODE_COUNT=10
# mfa-tenant: how long (ms) a tenant user's step-up (password + current
# code) authorises sensitive workspace actions (Owner-assisted MFA reset,
# regenerating recovery codes). Clamped to 30 s .. 1 h. Default 5 minutes.
USER_STEP_UP_TTL_MS=300000
# Password KDF: argon2 (default, OWASP-recommended) or scrypt (Node built-in
# fallback). `npm test` forces scrypt so tests run on any machine; leave this
# unset (argon2) in production.
PASSWORD_KDF=scrypt
COOKIE_SECURE=true                # only send cookies over HTTPS
# Number of reverse-proxy hops to trust for correct client IPs.
# Set to 1 on Render/Railway/Docker-behind-nginx, 0 when exposing directly.
TRUST_PROXY=1

# --- Razorpay (Phase 6.1, one-time order flow, test mode by default) --------
# Disabled by default; the free tier works without any of these set.
RAZORPAY_ENABLED=false
# Public Key ID (also exposed to the browser via the checkout response).
RAZORPAY_KEY_ID=
# Server-only secret. NEVER expose to the frontend, logs, or docs.
RAZORPAY_KEY_SECRET=
# Server-only webhook secret (Razorpay Dashboard > Settings > Webhooks).
RAZORPAY_WEBHOOK_SECRET=
# Explicit mode: test | live. Never auto-switches. Live requires real
# merchant credentials AND recurring-payment eligibility review.
RAZORPAY_ENVIRONMENT=test
# Authoritative plan pricing (minor units, e.g. paise). The plan catalogue
# carries NO prices; a plan without an entry here is NOT purchasable (422).
# Example (do NOT commit real commercial decisions without product sign-off):
# RAZORPAY_PLAN_MAPPING_JSON={"starter":{"amountMinor":49900,"currency":"INR","interval":"one-time"},"pro":{"amountMinor":99900,"currency":"INR","interval":"one-time"}}
RAZORPAY_PLAN_MAPPING_JSON=
# Billing reconciliation sweep (recovers missed webhooks; idempotent).
JOB_BILLING_RECONCILE_ENABLED=false
JOB_BILLING_RECONCILE_CRON=*/15 * * * *
# billing: prepaid-term model (roadmap 3.1). Plans sell monthly / annual terms
# through one-time orders; nothing is charged automatically. Prices live on the
# plan (`data.prices`, admin-editable); RAZORPAY_PLAN_MAPPING_JSON seeds them:
#   {"pro":{"month":{"amountMinor":99900,"currency":"INR"},"year":{"amountMinor":999000,"currency":"INR"}}}
# (the older flat {"amountMinor":...,"interval":"one-time"} entry is read as a monthly term).
# Lifecycle job: term end -> past_due (grace) -> restricted, canceled -> expired,
# trial end -> free, queued downgrades, renewal reminder emails.
JOB_BILLING_LIFECYCLE_ENABLED=true
JOB_BILLING_LIFECYCLE_CRON=5 * * * *
# Grace days after an unrenewed term when the plan defines none.
BILLING_DEFAULT_GRACE_DAYS=7
# Renewal reminder emails, in days before the term ends.
BILLING_RENEWAL_REMINDER_DAYS=7,1
# Unpaid checkouts older than this are expired by reconciliation (hours).
BILLING_PENDING_EXPIRE_HOURS=48
# Reconcile backoff per open checkout (ms, doubles per attempt up to the max).
BILLING_RECONCILE_BACKOFF_BASE_MS=60000
BILLING_RECONCILE_BACKOFF_MAX_MS=21600000
# Stored webhook events are retried with backoff up to this many times.
BILLING_WEBHOOK_MAX_ATTEMPTS=8
# Seed the default plan catalogue at startup (idempotent).
BILLING_SEED_PLANS_ON_STARTUP=true
# Stored payment webhook deliveries are kept this many days (retention job).
RETENTION_BILLING_WEBHOOK_EVENTS_DAYS=400
# Daily usage-counter reconciliation (recounts connectors, dashboards, reports,
# alerts, seats and stored rows). Review a dry run first:
#   npm run db:reconcile-usage            (dry run)
#   npm run db:reconcile-usage -- --apply (write corrections)
JOB_USAGE_RECONCILE_ENABLED=false
JOB_USAGE_RECONCILE_CRON=30 2 * * *
# Usage API warning threshold, in percent of a plan limit.
USAGE_WARNING_THRESHOLD_PERCENT=80
# Reconciliation skips counters that changed within this window (ms).
USAGE_RECONCILE_SETTLE_MS=120000
# Retention of per-day metered counters such as API calls (days).
USAGE_METERED_RETENTION_DAYS=90
# A webhook delivery's storedRows reservation still open after this many hours
# is presumed lost; reconciliation then stops counting it (hours).
USAGE_RESERVATION_TTL_HOURS=24

# --- members: workspace members, invitations and deletion (roadmap 2.10) ---
# Invitation link lifetime (days, 1-90). Expired invitations stay as history.
INVITATION_TTL_DAYS=7
JOB_INVITATION_EXPIRY_ENABLED=true
JOB_INVITATION_EXPIRY_CRON=*/30 * * * *
# Days between an owner's deletion request and the purge of the workspace.
TENANT_DELETION_GRACE_DAYS=30
# The purge job deletes every record of a workspace whose grace period ended
# and stores a verification report. Review before enabling on the worker.
JOB_TENANT_PURGE_ENABLED=false
JOB_TENANT_PURGE_CRON=15 * * * *
TENANT_PURGE_BATCH_SIZE=5
TENANT_PURGE_MAX_ATTEMPTS=5
TENANT_PURGE_LEASE_MS=1800000
# Keep a purged workspace's audit rows until RETENTION_AUDIT_LOG_DAYS.
TENANT_PURGE_RETAIN_AUDIT_LOGS=true
# Keep payment / subscription-history / billing-webhook records of a purged
# workspace as financial records (confirm the period with legal review).
TENANT_PURGE_RETAIN_BILLING_RECORDS=true
# Also schedule archived workspaces for purge N days after archiving.
TENANT_PURGE_ARCHIVED_ENABLED=false
TENANT_ARCHIVED_RETENTION_DAYS=30
# Retention of invitation history and tenant-deletion evidence (days).
RETENTION_TENANT_INVITATION_DAYS=365
RETENTION_TENANT_DELETION_DAYS=1095

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000       # 15 minutes
RATE_LIMIT_MAX=300                # requests per window per IP
RATE_LIMIT_STRICT_MAX=20          # access-request submissions per IP

# Per-route auth limits (one bucket per route class, shared through Redis
# when REDIS_URL is set). A 429 carries Retry-After and code RATE_LIMITED.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_LOGIN_MAX=10          # login per IP + account
AUTH_RATE_LIMIT_LOGIN_IP_MAX=50       # login per IP across accounts
AUTH_RATE_LIMIT_REFRESH_MAX=120       # refresh per IP + session cookie
AUTH_RATE_LIMIT_PASSWORD_MAX=5        # password forgot/reset per IP + account
AUTH_RATE_LIMIT_INVITATION_MAX=20     # invitation preview/accept per IP
AUTH_RATE_LIMIT_MFA_MAX=10            # admin MFA enrol/verify/disable per admin
AUTH_RATE_LIMIT_VERIFICATION_MAX=5    # email verify/resend per IP
AUTH_RATE_LIMIT_REGISTER_MAX=10       # self-service registration per IP

# Per-IP window/limit for the external API surface (X-Api-Key routes).
EXTERNAL_API_RATE_LIMIT_WINDOW_MS=60000
EXTERNAL_API_RATE_LIMIT_MAX=60
# Per-IP window/limit for the public embed read ({token} routes).
EMBED_RATE_LIMIT_WINDOW_MS=60000
EMBED_RATE_LIMIT_MAX=120

# --- External API keys (Sprint 9) --------------------------------------------
# Default lifetime (days) for a key when the caller sets no expiry.
API_KEY_TTL_DAYS=90
# Per-tenant cap on simultaneously-active keys.
API_KEY_MAX_PER_TENANT=100
# devapi: key lifecycle and per-key rate limit.
API_KEY_MAX_TTL_DAYS=365
API_KEY_ROTATION_OVERLAP_MINUTES=60
API_KEY_RATE_LIMIT_WINDOW_MS=60000
API_KEY_RATE_LIMIT_MAX=120

# --- Embed tokens (Sprint 9) -------------------------------------------------
# Default token lifetime (seconds) when the caller sets no expiry.
EMBED_TOKEN_DEFAULT_TTL_SEC=86400        # 24h
# Hard ceiling for any embed token lifetime (seconds).
EMBED_TOKEN_MAX_TTL_SEC=604800           # 7d
# Cap on concurrently-active embed tokens per dashboard.
EMBED_MAX_PER_DASHBOARD=50
# Opt-in: reflect any Origin on the public embed read. When false only CORS_ORIGINS may call it.
EMBED_CORS_ALLOW_ALL=false
# embedding: embed session lifetime (iframe handshake) and share-link TTL cap.
EMBED_SESSION_TTL_SEC=900
EMBED_SHARE_MAX_TTL_SEC=7776000

# --- Analytics --------------------------------------------------------------
# Server-side time limit for a single analytics aggregation (milliseconds).
ANALYTICS_QUERY_TIMEOUT_MS=15000
# Per-tenant limit on concurrent analytics aggregations (per API process).
ANALYTICS_MAX_CONCURRENT_QUERIES_PER_TENANT=4
# Queries that may wait for a free slot before the tenant receives 429.
ANALYTICS_MAX_QUEUED_QUERIES_PER_TENANT=16
# How long a waiting query may queue for a slot (milliseconds).
ANALYTICS_QUERY_QUEUE_TIMEOUT_MS=10000

# --- reports: report artefacts and analytics exports ------------------------
# Hard safety cap on rows in one report artefact / analytics export. Hitting it
# marks the run `truncated` (XLSX is additionally capped at 1,048,575 rows).
ARTIFACT_MAX_ROWS=1000000
# Server-side time limit for the cursor that streams one artefact (milliseconds).
ARTIFACT_QUERY_TIMEOUT_MS=600000
# Lifetime of a signed download link for an artefact (seconds, 30-3600).
ARTIFACT_DOWNLOAD_URL_TTL_SECONDS=300

# --- Socket.IO --------------------------------------------------------------
# Comma-separated origins allowed to open WebSocket connections.
SOCKET_CORS_ORIGIN=http://localhost:3000
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_MAX_HTTP_BUFFER_SIZE=1000000
SOCKET_TRANSPORTS=polling,websocket
# Sockets one signed-in user/admin may hold open per instance (0 = no cap).
SOCKET_MAX_CONNECTIONS_PER_IDENTITY=20

# --- Redis (cache + queue transport) ---------------------------------------
# Leave empty to use the in-memory transport (dev/test only).
REDIS_URL=

# --- Storage ---------------------------------------------------------------
# local (filesystem) or s3 (any S3-compatible service).
STORAGE_PROVIDER=local
STORAGE_BASE_DIR=uploads
# Required when STORAGE_PROVIDER=s3:
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=                      # leave empty for AWS, set for MinIO/R2/etc.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false         # true for MinIO and some S3-compatible services

# --- Encryption ------------------------------------------------------------
# Dedicated key for at-rest encryption. Required in production and should be a
# random value of at least 32 characters. Development may fall back to JWT_SECRET.
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_VERSION=1

# --- Mail (reserved for future transactional email) -------------------------
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
MAIL_SECURE=false                 # true when SMTP_PORT is 465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=SaaS Analytics Platform <noreply@localhost>
# retention: bounded SMTP timeouts (ms) so a slow or blocked SMTP egress
# fails fast; the email outbox retries failed sends.
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# Upper bound on the transport check behind GET /monitoring/health/mail.
SMTP_VERIFY_TIMEOUT_MS=5000
# retention: durable email outbox (OutboundEmail), drained by the email job.
# Attempts before a message is dead-lettered (then requeue it from
# monitoring), and the exponential backoff between attempts.
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_BACKOFF_BASE_MS=30000
OUTBOX_BACKOFF_MAX_MS=3600000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=120000
# Send a new message right after it is enqueued (the job retries failures).
OUTBOX_DISPATCH_ON_ENQUEUE=true

# --- Scheduler (node-cron infrastructure) ----------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
# Lease on the per-job distributed lock (Redis SET NX PX when REDIS_URL is
# set, otherwise a MongoDB lock document). Renewed while the job runs.
SCHEDULER_LOCK_LEASE_MS=300000
# Lease held on a due report/alert while one instance acts on it.
SCHEDULER_CLAIM_LEASE_MS=300000

# --- Process role (durable jobs) --------------------------------------------
# web    = HTTP + Socket.IO only (enqueues jobs, runs no consumers or cron)
# worker = queue consumers + scheduler, no HTTP (`npm run start:worker`)
# all    = everything in one process (default; development and single-instance)
# Production with more than one instance: run the web service with
# PROCESS_ROLE=web and one worker service with `npm run start:worker`.
# PROCESS_ROLE=web requires REDIS_URL.
PROCESS_ROLE=all
# Optional stable id for this process in job-run records (defaults to
# RENDER_INSTANCE_ID, then hostname:pid).
INSTANCE_ID=
# Producers fail with a 503 QUEUE_TIMEOUT instead of hanging when Redis is down.
QUEUE_PRODUCER_TIMEOUT_MS=5000

# --- Support (Sprint 8) ------------------------------------------------------
# Max impersonation sessions an admin may start per UTC day (0 disables).
SUPPORT_IMPERSONATION_DAILY_CAP=20
# Lifetime of an impersonation bearer token before it expires.
SUPPORT_IMPERSONATION_TOKEN_TTL=15m
# support: impersonation needs a consent window from the workspace (or an
# approved break-glass grant). Longest window an Owner/Admin may grant (hours)
# and how long an approved break-glass grant stays usable. Support sessions are
# read-only, never refresh, and are capped at 60 minutes whatever the TTL says.
SUPPORT_CONSENT_MAX_HOURS=72
SUPPORT_BREAK_GLASS_TTL=1h

# --- Audit trail (roadmap 2.5) -----------------------------------------------
# Optional secret (32+ random characters) that signs the audit hash chain with
# HMAC-SHA-256. Without it the chain still detects edits, but someone with
# database write access could recompute it. Keep it out of the database.
# After a rotation, list the old keys (comma-separated) so verification of
# older rows keeps working: `node scripts/ci/verify-audit-chain.js`.
AUDIT_CHAIN_KEY=
AUDIT_CHAIN_PREVIOUS_KEYS=
# Denied 401/403 requests are audited once per (actor or ip, tenant, route,
# reason) per window, capped per process per window.
AUDIT_DENIED_WINDOW_SEC=60
AUDIT_DENIED_MAX_PER_WINDOW=300
# Failed logins reach the audit trail once per (email, ip, reason) per window
# (every attempt is still kept in LoginAttempt).
AUDIT_LOGIN_FAILURE_WINDOW_SEC=60

# --- detection: platform security detection (roadmap 2.6) -------------------
# Detector job: evaluates every rule incrementally (watermarks) under the
# scheduler lock and raises SecurityAlert records for /admin/security-alerts.
JOB_SECURITY_DETECTION_ENABLED=true
JOB_SECURITY_DETECTION_CRON=*/5 * * * *
# Events younger than this many seconds wait for the next tick (buffered writers).
SECURITY_DETECTION_SETTLE_SEC=60
# First run looks back this far; catch-up after downtime is capped.
SECURITY_DETECTION_INITIAL_LOOKBACK_MINUTES=60
SECURITY_DETECTION_MAX_CATCHUP_HOURS=24
# Per-rule threshold overrides, e.g.
# {"auth.credential_stuffing":{"minFailures":30},"support.impersonation":{"enabled":false}}
# The platform setting `security.detection.rules` (json) overrides this.
SECURITY_DETECTION_RULES_JSON=
# On-call notification for alerts at or above this severity (low|medium|high|critical).
SECURITY_ALERT_NOTIFY_MIN_SEVERITY=high
# Comma-separated on-call addresses; platform setting `security.alerts.emails` overrides.
SECURITY_ALERT_EMAILS=
# Optional generic webhook (POST JSON); platform setting `security.alerts.webhookUrl` overrides.
SECURITY_ALERT_WEBHOOK_URL=
# A detection closed as a false positive within this many hours is suppressed (0 disables).
SECURITY_ALERT_FALSE_POSITIVE_SUPPRESS_HOURS=24
# Per-minute request signals (API-key use, rate-limit hits, request volume,
# webhook signature failures) feeding the API-key, volume and connector rules.
SECURITY_SIGNALS_ENABLED=true
SECURITY_SIGNALS_FLUSH_MS=10000
SECURITY_SIGNALS_MAX_KEYS=10000
RETENTION_SECURITY_SIGNAL_DAYS=35

# --- Retention (Sprint 8 cleanup job) ----------------------------------------
# How many days records are kept before the cleanup job hard-deletes them.
RETENTION_AUDIT_LOG_DAYS=90
RETENTION_ACCESS_LOG_DAYS=30
RETENTION_LOGIN_ATTEMPT_DAYS=30
RETENTION_SESSION_DAYS=90
RETENTION_IDEMPOTENCY_DAYS=1
RETENTION_EXPORT_DAYS=1
# Job-run and connector sync-run history.
RETENTION_JOB_RUN_DAYS=30
RETENTION_SYNC_RUN_DAYS=90
# retention: windows enforced by the cleanup job (`npm run db:retention`
# previews them). 0 disables a policy. Security events live in the audit
# trail and follow RETENTION_AUDIT_LOG_DAYS.
RETENTION_EXPIRED_TOKEN_DAYS=1
RETENTION_NOTIFICATION_DAYS=90
RETENTION_ALERT_EVENT_DAYS=180
RETENTION_ANALYTICS_QUERY_DAYS=90
# Export request rows outlive their file (RETENTION_EXPORT_DAYS) so a late
# poll gets 410 rather than 404.
RETENTION_EXPORT_RECORD_DAYS=30
RETENTION_REPORT_ARTIFACT_DAYS=30
RETENTION_OUTBOX_DAYS=30
# Soft-deleted rows are hard-deleted, and deleted users anonymised then
# deleted, after these windows.
RETENTION_SOFT_DELETE_DAYS=30
RETENTION_DELETED_USER_DAYS=30
# Purge every tenant-owned row of archived tenants after this many days
# (audit trail and billing records are kept). 0 = never (default).
RETENTION_ARCHIVED_TENANT_DAYS=0
# Bounded batches: rows per delete, batches per policy per run.
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_RUN=200
# true = scheduled runs only report what they would delete.
RETENTION_DRY_RUN=false
# Comma-separated tenant ids under legal hold (never purged). A Tenant row
# with `legalHold: true` is also held.
RETENTION_LEGAL_HOLD_TENANT_IDS=

# --- Connectors (Sprint 4) --------------------------------------------------
# Max CSV upload size in MB (multer caps the buffered file).
CONNECTOR_CSV_MAX_UPLOAD_MB=10
# Max XLSX upload size in MB (Sprint 9).
CONNECTOR_XLSX_MAX_UPLOAD_MB=10
# Allow MongoDB connectors to reach private, loopback or link-local hosts.
# Defaults to true outside production and false in production (SSRF guard).
# Enable in production only for a deliberately private deployment.
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
# External-source MongoDB sync guards (Sprint 9).
MONGODB_CONNECTOR_MAX_DOCS_PER_SYNC=100000
MONGODB_CONNECTOR_CONNECT_TIMEOUT_MS=10000
MONGODB_CONNECTOR_SERVER_SELECTION_TIMEOUT_MS=5000
# A queued/running sync holds a lease (renewed while it runs). When it
# expires the stale-job reaper marks the run abandoned and resets the connector.
CONNECTOR_SYNC_LEASE_MS=900000
# Times the reaper re-queues an interrupted MongoDB pull sync before failing it.
CONNECTOR_SYNC_MAX_RECOVERIES=1
# Connector sync queue sizing.
CONNECTOR_QUEUE_CONCURRENCY=5
CONNECTOR_QUEUE_ATTEMPTS=5
CONNECTOR_QUEUE_BACKOFF_MS=2000
# Default webhook signature tolerance (seconds) when a connector does not
# set `toleranceSeconds` in its own config.
WEBHOOK_TOLERANCE_SECONDS=300
# Encryption context purpose scoping connector secrets per tenant.
CONNECTOR_ENCRYPTION_PURPOSE=connector
# Optional egress allow-list for network connectors (comma separated host
# names, or `.example.com` suffixes). Empty = any public host. The platform's
# own MongoDB and Redis hosts are always refused.
CONNECTOR_EGRESS_ALLOWED_HOSTS=
# Hard cap on rows one CSV / XLSX / webhook sync may ingest.
CONNECTOR_MAX_ROWS_PER_SYNC=100000
# Wall-clock budget for one sync job (ms); a stalled source fails after this.
CONNECTOR_SYNC_TIMEOUT_MS=600000
# XLSX zip-bomb guard: max total inflated size of a workbook (MB) and the
# widest accepted row (columns).
CONNECTOR_XLSX_MAX_UNCOMPRESSED_MB=100
CONNECTOR_XLSX_MAX_COLUMNS=1000
# External MongoDB socket idle timeout and per-query server time limit (ms).
MONGODB_CONNECTOR_SOCKET_TIMEOUT_MS=30000
MONGODB_CONNECTOR_QUERY_TIMEOUT_MS=60000
# Inbound webhook limits: body size (KB) and records per delivery.
WEBHOOK_MAX_BODY_KB=256
WEBHOOK_MAX_RECORDS=1000
# How long a connector's decrypted webhook signing key is cached (seconds).
WEBHOOK_KEY_CACHE_TTL_SECONDS=300
# Accept legacy body-only `sha256=` signatures from webhook connectors created
# before timestamp-bound (`v2`) signing. Set to false once senders migrated.
WEBHOOK_LEGACY_SIGNATURES_ENABLED=true

# --- Background jobs (all disabled in Phase 1) ------------------------------
JOB_SHEET_SYNC_CRON=0 */6 * * *
JOB_SHEET_SYNC_ENABLED=false
# retention: the email job drains the email outbox (retries, dead letters),
# so it runs every minute by default.
JOB_EMAIL_CRON=* * * * *
JOB_EMAIL_ENABLED=true
# retention: the cleanup job enforces the RETENTION_* windows. Run
# `npm run db:retention` (dry run) against production first, then enable.
JOB_CLEANUP_CRON=0 3 * * *
JOB_CLEANUP_ENABLED=false
JOB_ANOMALY_CRON=0 * * * *
JOB_ANOMALY_ENABLED=false
# Stale-job reaper: recovers connectors stuck in queued/running past their
# lease and closes job runs whose worker stopped heartbeating.
JOB_STALE_RECOVERY_CRON=*/5 * * * *
JOB_STALE_RECOVERY_ENABLED=true

# --- Logging ----------------------------------------------------------------
# development: debug + pretty output. production: info + JSON output.
LOG_LEVEL=
# Comma-separated pino redact paths (sensitive values are masked in logs).
LOG_REDACT=req.headers.authorization,req.headers.cookie,password,authorization,jwt,token

# --- Observability (roadmap 2.8) --------------------------------------------
# Logs additionally mask sensitive keys at any depth and credentials inside
# text (bearer tokens, JWTs, ?token= values, /embed/<token>, /webhooks/<token>,
# URI passwords, session cookies). See src/utils/redact.js.
# Bearer token Prometheus must send to GET /api/v1/metrics (16+ characters).
# Unset = the metrics endpoint is disabled (404).
METRICS_TOKEN=
# Error reporter: none (default) | log | http. With http, events are POSTed as
# JSON to ERROR_REPORTER_URL (https in production) with an optional bearer
# token. Events are scrubbed of secrets and PII before they leave the process.
ERROR_REPORTER=
ERROR_REPORTER_URL=
ERROR_REPORTER_TOKEN=
ERROR_REPORTER_TIMEOUT_MS=3000
ERROR_REPORTER_MAX_EVENTS_PER_MINUTE=60
ERROR_REPORTER_DEDUPE_WINDOW_MS=60000
# Frontend crash reports accepted per client IP per minute.
CLIENT_ERROR_RATE_LIMIT_MAX=20
# Readiness (/api/v1/health/ready): per-check budget, cache for the slower
# non-critical checks (storage, scheduler) and for the SMTP verify.
READINESS_CHECK_TIMEOUT_MS=1500
READINESS_CACHE_TTL_MS=30000
READINESS_SMTP_TTL_MS=120000
# Public status endpoint (/api/v1/status) cache.
STATUS_CACHE_TTL_MS=15000
# SMTP transport timeouts: see SMTP_*_TIMEOUT_MS in the mail section.
# After the boot attempts fail, the web process keeps reconnecting to MongoDB
# with exponential backoff capped at this delay (ms); readiness stays 503.
MONGODB_RECONNECT_MAX_DELAY_MS=30000

# --- Request body limits ----------------------------------------------------
REQUEST_BODY_LIMIT=1mb

# --- Graceful shutdown ------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=10000
# Time shutdown waits for in-flight cron ticks and queue jobs (keep it below
# SHUTDOWN_TIMEOUT_MS; defaults to SHUTDOWN_TIMEOUT_MS - 3000).
SHUTDOWN_DRAIN_TIMEOUT_MS=7000

# delivery: scheduled report / alert delivery pipeline (roadmap 3.4).
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_MAX_RECIPIENTS=25
DELIVERY_ATTACH_MAX_BYTES=5242880
DELIVERY_PUBLIC_API_URL=
DELIVERY_TIMEOUT_MS=10000
JOB_DELIVERY_RETRY_ENABLED=true
DELIVERY_ALLOW_PRIVATE_NETWORKS=false
RETENTION_DELIVERY_RUNS_DAYS=180

# --- backups: tenant data export (roadmap 2.9) -------------------------------
# Hours a finished export archive stays downloadable before the expiry job
# deletes it (configure an S3 lifecycle rule on storage/tenant-exports/ too).
TENANT_EXPORT_TTL_HOURS=72
# Lifetime of one signed download URL in seconds (30-3600).
TENANT_EXPORT_DOWNLOAD_URL_TTL_SECONDS=300
# Exports a workspace may request itself per rolling 24 hours.
TENANT_EXPORT_DAILY_LIMIT=3
# Processing lease (renewed while running) and attempts before failing.
TENANT_EXPORT_LEASE_MS=900000
TENANT_EXPORT_MAX_ATTEMPTS=3
# A queued export not picked up within this many minutes is failed.
TENANT_EXPORT_QUEUED_TIMEOUT_MINUTES=360
# Widest dataset CSV; extra columns stay in the JSONL copy.
TENANT_EXPORT_MAX_CSV_COLUMNS=1000
# Scratch directory for building archives (empty = OS temp dir).
TENANT_EXPORT_WORK_DIR=
# Hourly sweep: deletes expired archives, fails abandoned exports.
JOB_TENANT_EXPORT_EXPIRY_CRON=20 * * * *
JOB_TENANT_EXPORT_EXPIRY_ENABLED=true

# ai-ask: natural-language analytics provider (roadmap 4.A2). noop = disabled (501).
# AI_PROVIDER picks the adapter (noop | gemini); AI_MODEL picks the Gemini model
# id it calls, e.g. gemini-2.5-flash or gemini-3.6-flash (must start with
# "gemini-"; an invalid id makes /ai/status report AI_MODEL_INVALID). These are
# read from the host's environment: a local .env does not configure a deployment.
AI_PROVIDER=noop
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_QUESTION_LENGTH=500
# RETENTION_AI_QUESTIONS_DAYS=90
