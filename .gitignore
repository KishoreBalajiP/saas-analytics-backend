# Dependencies
node_modules/

# Environment files - never commit real secrets
.env
.env.*
!.env.example

# Logs
logs/*
!logs/.gitkeep
*.log
npm-debug.log*

# Uploads (user data)
uploads/*
!uploads/.gitkeep

# Test / build output
coverage/
dist/
build/
# Captured local test-run logs (never commit these)
/final-results.txt
/summary.txt
/test-output.txt
/test-all-output.txt

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Misc
*.pid
*.seed
*.pid.lock
