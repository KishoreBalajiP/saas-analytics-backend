# Dependencies
node_modules/

# Environment files - never commit real secrets
.env
.env.*
!.env.example

# Logs
logs/*
!logs/.gitkeep
*.log
npm-debug.log*

# Uploads (user data)
uploads/*
!uploads/.gitkeep

# Test / build output
coverage/
dist/
build/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Misc
*.pid
*.seed
*.pid.lock
